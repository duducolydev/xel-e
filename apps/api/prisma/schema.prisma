generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../DOCS/erd_prisma.svg"
  theme    = "neutral"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ELEVE
  PROFESSEUR
  PARENT
  ADMIN
}

enum StatutLecon {
  BROUILLON
  EN_REVUE
  PUBLIE
}

enum TypeQuestion {
  QCM
  VRAI_FAUX
  REPONSE_COURTE
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  ANNULE
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
}

enum StatutCompte {
  ACTIF
  EN_ATTENTE_VALIDATION
}

enum FrequenceResume {
  HEBDOMADAIRE
  MENSUELLE
  AUCUNE
}

enum CanalNotification {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum TypeJetonVerification {
  CONFIRMATION_EMAIL
  REINITIALISATION_MOT_DE_PASSE
  CONSENTEMENT_PARENTAL
}

// ---------------------------------------------------------------------------
// Utilisateurs
// ---------------------------------------------------------------------------

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  identifiant     String?      @unique
  motDePasseHash  String
  role            Role
  nomComplet      String
  pseudonyme      String?      @unique
  statutCompte    StatutCompte @default(ACTIF)
  emailConfirmeLe DateTime?

  niveauId String?
  niveau   Niveau? @relation(fields: [niveauId], references: [id])

  naissanceMois          Int?
  naissanceAnnee         Int?
  contactParentEmail     String?
  consentementParentalLe DateTime?

  // Série de jours actifs, en jours calendaires de Dakar (AAAA-MM-JJ).
  serieJours       Int     @default(0)
  serieRecord      Int     @default(0)
  dernierJourActif String?
  // Classement : sur demande uniquement, sous pseudonyme.
  classementActif  Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  jetonsVerification JetonVerification[]

  enfants           ParentLink[]       @relation("ParentDeUser")
  parents           ParentLink[]       @relation("EnfantDeUser")
  progressions      Progression[]
  tentatives        Tentative[]
  badges            BadgeUtilisateur[]
  sujetsForum       SujetForum[]
  messages          Message[]
  signalements      Signalement[]
  abonnements       Abonnement[]
  notifications     Notification[]
  leconsRedigees    Lecon[]
  versionsPubliees  VersionLecon[]     @relation("VersionsPubliees")
  gainsXp           GainXp[]
  commentairesRevue CommentaireRevue[] @relation("CommentairesRevue")
  piecesJointes     PieceJointe[]
  codesLiaison      CodeLiaison[]      @relation("CodesLiaisonEleve")
  activites         ActiviteJour[]
  preferences       PreferencesParent?
  resumesEnvoyes    ResumeEnvoye[]

  @@index([role])
  @@index([niveauId])
}

model ParentLink {
  id        String   @id @default(uuid())
  parentId  String
  parent    User     @relation("ParentDeUser", fields: [parentId], references: [id])
  enfantId  String
  enfant    User     @relation("EnfantDeUser", fields: [enfantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([parentId, enfantId])
  @@index([enfantId])
}

// Code à usage unique (48 h) généré par l'élève ou l'admin, saisi par le parent pour se lier.
model CodeLiaison {
  id        String    @id @default(uuid())
  eleveId   String
  eleve     User      @relation("CodesLiaisonEleve", fields: [eleveId], references: [id])
  codeHash  String    @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  @@index([eleveId])
}

// Minutes d'activité par jour calendaire de Dakar (signal envoyé par les pages leçon et quiz).
model ActiviteJour {
  id            String @id @default(uuid())
  utilisateurId String
  utilisateur   User   @relation(fields: [utilisateurId], references: [id])
  jour          String
  minutes       Int    @default(0)

  @@unique([utilisateurId, jour])
}

model PreferencesParent {
  id        String          @id @default(uuid())
  parentId  String          @unique
  parent    User            @relation(fields: [parentId], references: [id])
  frequence FrequenceResume @default(HEBDOMADAIRE)
  email     Boolean         @default(true)
  whatsapp  Boolean         @default(false)
  sms       Boolean         @default(false)
  telephone String?
  updatedAt DateTime        @updatedAt
}

// Trace des résumés envoyés : un seul envoi par parent, période et canal (job rejouable sans doublon).
model ResumeEnvoye {
  id       String            @id @default(uuid())
  parentId String
  parent   User              @relation(fields: [parentId], references: [id])
  periode  String
  canal    CanalNotification
  envoyeLe DateTime          @default(now())

  @@unique([parentId, periode, canal])
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  familleId     String
  tokenHash     String    @unique
  expireLe      DateTime
  revoqueLe     DateTime?
  remplaceParId String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([familleId])
}

model JetonVerification {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  type      TypeJetonVerification
  tokenHash String                @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Référentiel pédagogique
// ---------------------------------------------------------------------------

model Niveau {
  id      String @id @default(uuid())
  libelle String @unique
  ordre   Int    @unique

  utilisateurs User[]
  chapitres    Chapitre[]
  sujetsForum  SujetForum[]
}

model Matiere {
  id      String @id @default(uuid())
  libelle String @unique

  chapitres   Chapitre[]
  sujetsForum SujetForum[]
}

model Chapitre {
  id        String  @id @default(uuid())
  niveauId  String
  niveau    Niveau  @relation(fields: [niveauId], references: [id])
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])
  titre     String
  ordre     Int

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lecons Lecon[]

  @@unique([niveauId, matiereId, ordre])
}

model Lecon {
  id            String      @id @default(uuid())
  chapitreId    String
  chapitre      Chapitre    @relation(fields: [chapitreId], references: [id])
  slug          String      @unique
  titre         String
  contenu       String?
  statut        StatutLecon @default(BROUILLON)
  // Numéro de la dernière version publiée (0 = jamais publiée).
  version       Int         @default(0)
  ordre         Int
  auteurId      String?
  auteur        User?       @relation(fields: [auteurId], references: [id])
  // Quiz de la copie de travail, au format de l'éditeur ; appliqué au quiz en ligne à la publication
  // (null = pas de modification en cours).
  quizBrouillon Json?
  soumisLe      DateTime?
  // Lectures comptées une fois par visiteur et par heure.
  vues          Int         @default(0)

  versionPublieeId String?        @unique
  versionPubliee   VersionLecon?  @relation("VersionPubliee", fields: [versionPublieeId], references: [id])
  versions         VersionLecon[] @relation("VersionsLecon")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  quiz         Quiz?
  progressions Progression[]
  commentaires CommentaireRevue[]

  @@unique([chapitreId, ordre])
  @@index([statut])
}

model CommentaireRevue {
  id        String   @id @default(uuid())
  leconId   String
  lecon     Lecon    @relation(fields: [leconId], references: [id])
  auteurId  String
  auteur    User     @relation("CommentairesRevue", fields: [auteurId], references: [id])
  contenu   String
  createdAt DateTime @default(now())

  @@index([leconId])
}

// Instantané figé d'une leçon au moment de sa publication (un trigger SQL interdit toute mise à jour).
model VersionLecon {
  id          String   @id @default(uuid())
  leconId     String
  lecon       Lecon    @relation("VersionsLecon", fields: [leconId], references: [id])
  numero      Int
  titre       String
  contenu     String
  sections    Json
  resume      String
  publieLe    DateTime @default(now())
  publieParId String?
  publiePar   User?    @relation("VersionsPubliees", fields: [publieParId], references: [id])

  publieeSur Lecon? @relation("VersionPubliee")

  @@unique([leconId, numero])
}

// ---------------------------------------------------------------------------
// Quiz et évaluation
// ---------------------------------------------------------------------------

model Quiz {
  id       String @id @default(uuid())
  leconId  String @unique
  lecon    Lecon  @relation(fields: [leconId], references: [id])
  dureeMax Int?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  questions  Question[]
  tentatives Tentative[]
}

model Question {
  id              String       @id @default(uuid())
  quizId          String
  quiz            Quiz         @relation(fields: [quizId], references: [id])
  type            TypeQuestion
  enonce          String
  choix           Json?
  reponseCorrecte Json
  // Affichée avec le corrigé, jamais avant la soumission.
  explication     String?
  bareme          Int          @default(1)
  ordre           Int

  @@index([quizId])
}

model Tentative {
  id            String    @id @default(uuid())
  quizId        String
  quiz          Quiz      @relation(fields: [quizId], references: [id])
  utilisateurId String
  utilisateur   User      @relation(fields: [utilisateurId], references: [id])
  reponses      Json?
  // Index de la question affichée, pour reprendre au même endroit.
  position      Int       @default(0)
  // "<utilisateurId>:<quizId>" tant que la tentative est en cours, null ensuite :
  // l'unicité garantit au plus une tentative en cours par élève et par quiz.
  enCoursCle    String?   @unique
  score         Float?
  pointsObtenus Float?
  pointsTotal   Float?
  // Corrigé figé à la soumission : l'historique ne change pas si le quiz est modifié ensuite.
  correction    Json?
  // XP rapportée par cette tentative (quiz réussi ou sans faute pour la première fois).
  xpGagne       Int       @default(0)
  demarreLe     DateTime  @default(now())
  termineLe     DateTime?

  @@index([quizId])
  @@index([utilisateurId, termineLe])
}

// ---------------------------------------------------------------------------
// Progression et gamification
// ---------------------------------------------------------------------------

model Progression {
  id            String    @id @default(uuid())
  utilisateurId String
  utilisateur   User      @relation(fields: [utilisateurId], references: [id])
  leconId       String
  lecon         Lecon     @relation(fields: [leconId], references: [id])
  termineLe     DateTime?
  quizReussiLe  DateTime?
  meilleurScore Float?

  @@unique([utilisateurId, leconId])
}

enum SourceXp {
  LECON_TERMINEE
  QUIZ_REUSSI
  QUIZ_PARFAIT
}

// Registre des gains d'XP : l'unicité (utilisateur, source, clé) interdit tout gain en double,
// et les dates permettent le classement de la semaine.
model GainXp {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id])
  source        SourceXp
  cle           String
  xp            Int
  gagneLe       DateTime @default(now())

  @@unique([utilisateurId, source, cle])
  @@index([gagneLe])
}

model Badge {
  id          String  @id @default(uuid())
  code        String  @unique
  libelle     String
  description String?

  utilisateurs BadgeUtilisateur[]
}

model BadgeUtilisateur {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id])
  badgeId       String
  badge         Badge    @relation(fields: [badgeId], references: [id])
  obtenuLe      DateTime @default(now())

  @@unique([utilisateurId, badgeId])
}

// ---------------------------------------------------------------------------
// Forum
// ---------------------------------------------------------------------------

model SujetForum {
  id               String   @id @default(uuid())
  niveauId         String
  niveau           Niveau   @relation(fields: [niveauId], references: [id])
  matiereId        String
  matiere          Matiere  @relation(fields: [matiereId], references: [id])
  titre            String
  auteurId         String
  auteur           User     @relation(fields: [auteurId], references: [id])
  // Tri des sujets par activité récente.
  dernierMessageLe DateTime @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]

  @@index([niveauId, matiereId, dernierMessageLe])
}

model Message {
  id        String     @id @default(uuid())
  sujetId   String
  sujet     SujetForum @relation(fields: [sujetId], references: [id])
  auteurId  String
  auteur    User       @relation(fields: [auteurId], references: [id])
  contenu   String
  // Masqué automatiquement au 3e signalement, en attendant la décision de la modération.
  masque    Boolean    @default(false)
  masqueLe  DateTime?
  // Innocenté par la modération : de nouveaux signalements ne le masquent plus automatiquement.
  verifieLe DateTime?

  // Suppression par la modération (le texte reste en base pour l'historique de modération).
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  signalements  Signalement[]
  piecesJointes PieceJointe[]

  @@index([sujetId, createdAt])
}

model Signalement {
  id          String    @id @default(uuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id])
  signalantId String
  signalant   User      @relation(fields: [signalantId], references: [id])
  motif       String?
  createdAt   DateTime  @default(now())
  // Soldé par une décision de la modération (message restauré ou supprimé).
  traiteLe    DateTime?

  @@unique([messageId, signalantId])
  @@index([traiteLe])
}

// Image ou PDF analysé par l'antivirus avant stockage ; rattaché à un message à sa publication.
model PieceJointe {
  id          String   @id @default(uuid())
  auteurId    String
  auteur      User     @relation(fields: [auteurId], references: [id])
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id])
  cle         String   @unique
  nomOriginal String
  type        String
  taille      Int
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([auteurId])
}

// Filtre de premier niveau du forum, éditable par l'administration.
model TermeInterdit {
  id        String   @id @default(uuid())
  terme     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Abonnements et paiements
// ---------------------------------------------------------------------------

model Abonnement {
  id            String           @id @default(uuid())
  utilisateurId String
  utilisateur   User             @relation(fields: [utilisateurId], references: [id])
  plan          String
  statut        StatutAbonnement @default(ACTIF)
  expireLe      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paiements Paiement[]

  @@index([utilisateurId])
}

model Paiement {
  id           String         @id @default(uuid())
  abonnementId String
  abonnement   Abonnement     @relation(fields: [abonnementId], references: [id])
  fournisseur  String
  statut       StatutPaiement @default(EN_ATTENTE)
  montant      Int
  refExterne   String         @unique
  createdAt    DateTime       @default(now())

  @@index([abonnementId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id])
  type          String
  contenu       String
  lu            Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([utilisateurId, lu])
}
