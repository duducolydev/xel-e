{
  "name": "@xel-e/api",
  "version": "0.0.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed-runner.ts"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "generate": "prisma generate --generator client",
    "docs:erd": "prisma generate --generator erd",
    "seed": "tsx prisma/seed-runner.ts",
    "db:migrate:dev": "prisma migrate dev --skip-generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:down": "tsx prisma/migrate-down.ts",
    "db:migrate:reset": "prisma migrate reset --force --skip-generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^5.22.0",
    "@xel-e/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@xel-e/config": "workspace:*",
    "eslint": "^9.17.0",
    "prisma": "^5.22.0",
    "prisma-erd-generator": "^1.11.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
