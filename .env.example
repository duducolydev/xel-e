DATABASE_URL=postgresql://xele:xele@127.0.0.1:5433/xele
REDIS_URL=redis://127.0.0.1:6379

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=xele
S3_ACCESS_KEY=xele
S3_SECRET_KEY=xele12345

# Au moins 16 caractères ; en production, des valeurs longues et aléatoires.
JWT_SECRET=change-me-in-dev
JWT_REFRESH_SECRET=change-me-too-in-dev
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Xel-E <no-reply@xele.sn>"
# Antivirus des pièces jointes du forum (service clamav de docker-compose).
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Tests e2e uniquement : API de mailhog pour lire les emails envoyés.
MAILHOG_API_URL=http://127.0.0.1:8025

ANTHROPIC_API_KEY=

WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
OM_API_KEY=
OM_WEBHOOK_SECRET=

# Résumés aux parents par WhatsApp/SMS : mock (développement) ou http (passerelle ci-dessous).
NOTIF_PROVIDER=mock
NOTIF_HTTP_URL=
NOTIF_HTTP_TOKEN=
# Planification des résumés (dimanche 18 h et le 1er du mois à 18 h, heure de Dakar).
RESUMES_PLANIFIES=true
RESUME_BACKOFF_MS=60000

APP_URL=http://localhost:3010
API_URL=http://localhost:3001
API_PORT=3001
