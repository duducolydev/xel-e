{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "API_PORT",
    "API_URL",
    "APP_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL_SECONDS",
    "REFRESH_TTL_DAYS",
    "MAIL_FROM",
    "MAILHOG_API_URL",
    "NODE_ENV",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "NOTIF_PROVIDER",
    "ANTHROPIC_API_KEY",
    "WAVE_API_KEY",
    "WAVE_WEBHOOK_SECRET",
    "OM_API_KEY",
    "OM_WEBHOOK_SECRET"
  ],
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:cov": {
      "dependsOn": ["^build", "generate"]
    },
    "e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["generate"],
      "cache": false
    }
  }
}
